# Connect as the least-privilege app_readonly role (see
# db/migrations/003_restrict_permissions.sql — docker-compose creates this
# role automatically; for a non-Docker local Postgres, run that migration
# by hand first), not the postgres superuser.
DATABASE_URL=postgresql://app_readonly:changeme@localhost:5432/chennai

# "production" disables the interactive API docs (/docs, /redoc,
# /openapi.json). Leave unset for local development.
APP_ENV=development

# This is a public, unauthenticated read-only API — "*" (any origin) is the
# intended value. Set a comma-separated list instead only if you later
# decide to restrict who can call it directly.
ALLOWED_ORIGINS=*

# Reject any request body larger than this many bytes before parsing it.
MAX_REQUEST_BODY_BYTES=200000

# Per-client request budget, slowapi/limits syntax (e.g. "60/minute").
RATE_LIMIT_DEFAULT=60/minute
