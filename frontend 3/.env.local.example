# Where the FastAPI backend is running. Next proxies /api/* here (see next.config.mjs).
# This is a SERVER-side var (not exposed to the browser).
BACKEND_ORIGIN=http://localhost:8000

# Set to "1" to always use built-in mock data and never call the backend.
# Handy for demoing the UI/animations before Postgres + the API are running.
# When unset/"0", the app calls the real API and only falls back to mock on error.
NEXT_PUBLIC_USE_MOCK=0

# Optional: a MapLibre style URL. Defaults to a free, token-free CARTO dark
# basemap. To use Mapbox's own tiles, point this at a Mapbox style and append
# your token, or swap in any GL style JSON you like.
# NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
